{
  "name": "darkmsal",
  "version": "1.1.0",
  "description": "DarkMSAL - для Альма Матер с любовью. Клиентское приложение для студентов МГЮА",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "NODE_ENV=development electron .",
    "package:mac": "vite build && electron-builder --mac dmg",
    "package:apk": "vite build && npx cap sync android && cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../release/DarkMSAL-$npm_package_version.apk",
    "package:win": "vite build && electron-builder --win --x64",
    "package:fedora": "vite build && electron-builder --linux rpm --x64",
    "package:linux": "vite build && electron-builder --linux AppImage rpm deb --x64",
    "package:ipa": "vite build && npx cap sync ios && xcodebuild archive -workspace ios/App/App.xcworkspace -scheme App -configuration Release -destination 'generic/platform=iOS' -archivePath build/App.xcarchive CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=\"\" && mkdir -p release/Payload && cp -R build/App.xcarchive/Products/Applications/App.app release/Payload/ && (cd release && zip -qr -y DarkMSAL-1.0.ipa Payload && rm -rf Payload)",
    "build:userscript": "node scripts/build-userscript.js"
  },
  "build": {
    "appId": "ru.msal.darkmsal",
    "productName": "DarkMSAL",
    "copyright": "Copyright © 2026 DarkMSAL",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "DarkMSAL ${version}",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DarkMSAL"
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icons",
      "maintainer": "DarkMSAL Team <dev@msal.ru>"
    }
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor/core": "^7.0.1",
    "@capacitor/ios": "^7.6.9",
    "lucide-react": "^1.45.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/cli": "^7.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0"
  },
  "author": {
    "name": "DarkMSAL Team",
    "email": "dev@msal.ru"
  }
}
